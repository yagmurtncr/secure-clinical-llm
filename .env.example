# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SCLLM_CLUSTER_SECRET=
# At least 32 characters
SCLLM_JWT_SECRET=
SCLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SCLLM_DTYPE=bfloat16
# NER for names in free text + fail-closed privacy gate (1 = on, recommended)
SCLLM_NER=1
# path or hub id of the NER model; scripts/train_ner.py produces models/ner-clinical-tr
SCLLM_NER_MODEL=akdeniz27/bert-base-turkish-cased-ner
# 1 = model returns JSON explanations, values and statuses are rendered by the gateway
SCLLM_STRUCTURED=1
